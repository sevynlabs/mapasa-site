# Copie para .env.production (hospedagem comum) ou cadastre na Vercel (Settings → Environment Variables).

# URL pública do site, sem barra no final. Usada em canonical, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Mantenha "false" até as fotografias reais serem publicadas.
# Com "false", o site envia noindex e o robots.txt bloqueia buscadores.
NEXT_PUBLIC_ALLOW_INDEXING=false
